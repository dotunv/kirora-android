<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Default FCM receiver. Low priority, so an app's own FirebaseMessagingService wins; such
            apps forward to KiroraPush.handleMessage / KiroraPush.onNewToken.
        -->
        <service
            android:name="com.kirora.androidsdk.push.fcm.KiroraFirebaseService"
            android:exported="false">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name="com.kirora.androidsdk.push.fcm.KiroraPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
